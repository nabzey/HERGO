[front]
front_host ansible_host=FRONT_PUBLIC_IP ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/hergo-key.pem

[back]
back_host ansible_host=BACK_PRIVATE_IP ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/hergo-key.pem

[db]
db_host ansible_host=DB_PRIVATE_IP ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/hergo-key.pem

[all:vars]
ansible_python_interpreter=/usr/bin/python3

# SSH Jump Host configuration (use Front EC2 as a proxy to reach Back & DB in the private subnet)
[back:vars]
ansible_ssh_common_args='-o ProxyCommand="ssh -W %h:%p -q -i ~/.ssh/hergo-key.pem -o StrictHostKeyChecking=no ubuntu@FRONT_PUBLIC_IP"'

[db:vars]
ansible_ssh_common_args='-o ProxyCommand="ssh -W %h:%p -q -i ~/.ssh/hergo-key.pem -o StrictHostKeyChecking=no ubuntu@FRONT_PUBLIC_IP"'
