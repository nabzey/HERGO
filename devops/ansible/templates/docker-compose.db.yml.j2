version: '3.8'

services:
  hergo-db:
    image: postgres:16
    container_name: hergo_postgres
    environment:
      POSTGRES_DB: hergo
      POSTGRES_USER: {{ db_user | default('zeynab') }}
      POSTGRES_PASSWORD: {{ db_password | default('nouveaumotdepasse') }}
    ports:
      - "5432:5432"
    volumes:
      - pg_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ db_user | default('zeynab') }} -d hergo"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped

volumes:
  pg_data:
